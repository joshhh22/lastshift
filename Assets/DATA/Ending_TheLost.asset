  m_Script: {fileID: 11500000, guid: 57b505c02ebc92643803b7f2a9890fd8, type: 3}
  m_Name: Ending_TheLost
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: 
    text: Shift terakhir telah usai. Kereta evakuasi terakhir telah berangkat.
  - speaker: 
    text: Kamu terjebak di antara mematuhi sistem atau mengikuti nurani.
  - speaker: 
    text: Kamu selamat, namun bayangan mereka yang tertinggal akan terus menghantui.
