  m_Script: {fileID: 11500000, guid: 57b505c02ebc92643803b7f2a9890fd8, type: 3}
  m_Name: Ending_TheMachine
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: 
    text: Petugas 404, kami meninjau hasil kerjamu. Kamu tidak memberikan kelonggaran
      sekecil apa pun.
  - speaker: 
    text: Kamu membiarkan mereka kedinginan di luar demi menjaga efisiensi sistem
      the Core.
  - speaker: 
    text: Kamu bukan lagi manusia. Kamu adalah perpanjangan tangan dari mesin ini.
      Dan sistem sangat bangga padamu.
